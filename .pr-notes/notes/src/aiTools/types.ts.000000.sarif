              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/aiTools/types.ts"
                },
                "region": {
                  "startLine": 15,
                  "endLine": 22,
                  "snippet": {
                    "text": "// server-side helper rather than a `(projectRoot) => boolean` closure; see `detect.ts`.\n\nimport type { DevFeatureKey } from '../devFeatures.js';\n\n/**\n * How to tell whether a project uses this tool, expressed as data so the pure registry\n * stays free of `fs`. Evaluated by `detect.ts::detectsTool` (server-side) as:\n *"
                  }
                }
              }
            }
