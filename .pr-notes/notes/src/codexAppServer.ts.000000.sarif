        {
          "ruleId": "review-note",
          "ruleIndex": 0,
          "kind": "informational",
          "level": "none",
          "guid": "mrwv1solgtectfo2",
          "message": {
            "text": "Teardown fires `idle` + fallback done ONLY when work was in flight (`phase === 'active' || queue.length > 0`) — an idle session dying (e.g. shutdown) must not emit a spurious \"Codex finished\" Commands Log entry. Pending JSON-RPC requests are rejected (not left dangling) so a mid-handshake crash surfaces as a failed boot rather than a 60s timeout, and pending overlay popups are dismissed so the §47 UI can't hang on a dead session. See also `src/cli.ts` (exit hook calls `shutdownCodexAppServers`).\n",
            "markdown": "Teardown fires `idle` + fallback done ONLY when work was in flight (`phase === 'active' || queue.length > 0`) — an idle session dying (e.g. shutdown) must not emit a spurious \"Codex finished\" Commands Log entry. Pending JSON-RPC requests are rejected (not left dangling) so a mid-handshake crash surfaces as a failed boot rather than a 60s timeout, and pending overlay popups are dismissed so the §47 UI can't hang on a dead session. See also `src/cli.ts` (exit hook calls `shutdownCodexAppServers`).\n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/codexAppServer.ts"
                },
                "region": {
                  "startLine": 342,
                  "endLine": 365,
                  "snippet": {
                    "text": "    description: display.description,\n    input_preview: display.input_preview,\n    options: display.options,\n  });\n  session.pendingPermissionIds.add(request_id);\n  try {\n    const reply = await promise;\n    write(session, buildResponseLine(id, decisionFromReply(reply)));\n  } finally {\n    session.pendingPermissionIds.delete(request_id);\n  }\n}\n\nfunction request(session: Session, method: string, params: unknown, timeoutMs: number): Promise<unknown> {\n  const id = session.nextId++;\n  return new Promise<unknown>((resolve, reject) => {\n    const timer = setTimeout(() => {\n      session.pending.delete(id);\n      reject(new Error(`codex app-server: timeout waiting for ${method}`));\n    }, timeoutMs);\n    timer.unref();\n    session.pending.set(id, { resolve, reject, timer });\n    write(session, buildRequestLine(id, method, params));\n  });"
                  }
                }
              }
            }
          ],
